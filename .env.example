# PulseWise service (1B/1D — not in scope yet)
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://localhost:5432/pulsewise
REDIS_URL=redis://localhost:6379/0

PULSEWISE_PORT=8400
PULSEWISE_ENV=development

AGGREGATION_INTERVAL_MINUTES=60
AGGREGATION_LOOKBACK_HOURS=24

# Consumer products (VoiceWise, Hopwise) point at this URL
PULSEWISE_URL=http://localhost:8400
PULSEWISE_ENABLED=true

# Ingestion product allowlist. Comma-separated. Unset = the five built-in
# products (hopwise, voicewise, helmerwise, scriptwise, agentwise). Setting it
# REPLACES that default, so list every product you want admitted. Names are
# lowercased and must be <= 32 chars (pulse_events.product is VARCHAR(32)).
# PULSEWISE_VALID_PRODUCTS=hopwise,voicewise,helmerwise,scriptwise,agentwise,via,honedwise

# Circuit breaker overrides (defaults: 5 failures, 60s cooldown)
PULSEWISE_CIRCUIT_FAILURE_THRESHOLD=5
PULSEWISE_CIRCUIT_COOLDOWN_SECONDS=60

# Optional: override path the collector reads for /insights/{product}.
# Defaults to <repo_root>/data/insights_summary.json (written by Phase 1D summarizer).
# PULSEWISE_INSIGHTS_PATH=/path/to/insights_summary.json
